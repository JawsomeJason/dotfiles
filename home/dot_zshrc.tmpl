# Managed by chezmoi from ~/code/dotfiles/home/dot_zshrc.tmpl. Edit that file (or run
# `chezmoi edit ~/.zshrc`), not this one, or the next `dotfiles apply` puts it back.

# Completions for dotfiles itself (generated from its usage spec). Set before anything runs compinit,
# which nvm's completion does.
fpath=(~/.config/zsh/completions $fpath)

# ==============================================================================
# PATH
# ==============================================================================
export PATH="$PATH:$HOME/.local/bin"                       # user-local binaries
export PATH="$HOME/.bun/bin:$PATH"                         # bun
{{- if not .work }}
export BUN_INSTALL="$HOME/.bun"
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"       # bun completions
export PATH="/opt/homebrew/opt/rustup/bin:$HOME/.cargo/bin:$HOME/go/bin:$PATH"
path=($HOME/.local/bin ${path:#$HOME/.local/bin})          # user-local binaries win here
{{- end }}

# Work layers drop shell files here; later names win (10-shared.zsh, then 20-<job>.zsh)
for f in ~/.config/zsh/work/*.zsh(N); do source $f; done
unset f

# ==============================================================================
# Node / nvm
# ==============================================================================
if [[ -s /opt/homebrew/opt/nvm/nvm.sh ]]; then
  export NVM_DIR="$HOME/.nvm"
  source /opt/homebrew/opt/nvm/nvm.sh
  [ -s /opt/homebrew/opt/nvm/etc/bash_completion.d/nvm ] && source /opt/homebrew/opt/nvm/etc/bash_completion.d/nvm

  # Switch to the folder's .nvmrc Node on every cd (installing it if missing), and back to the
  # default Node on leaving. From the nvm README.
  autoload -Uz add-zsh-hook
  load-nvmrc() {
    local nvmrc_path="$(nvm_find_nvmrc)"
    if [ -n "$nvmrc_path" ]; then
      local nvmrc_node_version=$(nvm version "$(cat "${nvmrc_path}")")
      if [ "$nvmrc_node_version" = "N/A" ]; then
        nvm install
      elif [ "$nvmrc_node_version" != "$(nvm version)" ]; then
        nvm use --silent
      fi
    elif [ -n "$(PWD=$OLDPWD nvm_find_nvmrc)" ] && [ "$(nvm version)" != "$(nvm version default)" ]; then
      nvm use default --silent
    fi
  }
  add-zsh-hook chpwd load-nvmrc
  load-nvmrc
fi

# ==============================================================================
# Machine-local settings and secrets
# ==============================================================================
# Tokens and anything else this machine alone needs live in ~/.config/zsh/local.zsh, which is
# never in git. See ~/code/dotfiles/README.md.
[[ -r ~/.config/zsh/local.zsh ]] && source ~/.config/zsh/local.zsh
{{- if eq .chezmoi.os "darwin" }}

# An SSH session can't read the login keychain until it calls unlock once. While the keychain is
# already unlocked (by the desktop login), that call succeeds with any password, so try the password
# the connecting machine forwarded (the `personal` function sends one from 1Password), or an empty
# one, and only ask when the keychain is really locked. Only the interactive shell clears the
# password: ~/.zshenv also loads this file in the outer non-interactive shell that ssh starts.
if [[ -n $SSH_CONNECTION && -o interactive ]]; then
  if ! security unlock-keychain -p "${DOTFILES_KEYCHAIN_PASSWORD:-}" ~/Library/Keychains/login.keychain-db 2>/dev/null; then
    [[ -n ${DOTFILES_KEYCHAIN_PASSWORD:-} ]] && print -u2 "dotfiles: the forwarded password did not unlock the login keychain"
    print "Login keychain is locked; enter your Mac login password to unlock it."
    security unlock-keychain ~/Library/Keychains/login.keychain-db
  fi
  unset DOTFILES_KEYCHAIN_PASSWORD
fi
{{- end }}

# ==============================================================================
# Aliases
# ==============================================================================

# git
alias co='git checkout'
alias main='co main'

# npm
alias run='npm run'
alias dev='run dev'
alias refresh='git pull && nvm i && nvm use && npm install'   # sync branch, node version, deps

# upgrade: update every package manager and tool in ~/.config/dotfiles/upgrade-steps (the same table `dotfiles doctor`
# reads). Bare `upgrade` prints usage and runs nothing. A failing step does not stop the rest. Brew also covers uv,
# pnpm, bun, nvm, gh, mise and chezmoi themselves when they came from brew. Not covered on purpose: nvm-managed node
# versions (moving versions strands the npm -g packages; run `nvm install --lts` yourself).
function upgrade {
  local table=${DOTFILES_UPGRADE_STEPS:-$HOME/.config/dotfiles/upgrade-steps}
  local u_main=$'usage: upgrade <list|run> [options]\n  list [--missing]    installed steps and their commands; --missing: steps whose tool is not installed\n  run [step...]       upgrade every installed step, or only the named ones\n    --greedy          also upgrade self-updating casks (brew)\n    --skip <step>     leave a step out (repeatable)\n  -h, --help          this text; every verb takes -h too'
  local u_list=$'usage: upgrade list [--missing]\n  Print each installed step: id, then the command it runs.\n  --missing   print the steps whose tool is not installed instead: id, then the tool'
  local u_run=$'usage: upgrade run [--greedy] [--skip <step>]... [step...]\n  Run every installed step, or only the named ones. A failing step does not stop the rest.\n  A named step whose tool is missing is reported and counts as a failure.\n  --greedy       add --greedy to the brew step (self-updating casks)\n  --skip <step>  leave a step out (repeatable)'
  local verb=${1:-}; (( $# )) && shift
  local id tool cmd
  [[ -r $table || -z $verb || $verb == -h || $verb == --help ]] || { print -ru2 "upgrade: no step table at $table"; return 1 }
  case $verb in
    ''|-h|--help) print -r -- $u_main; return 0 ;;
    list)
      local missing=0
      while (( $# )); do
        case $1 in
          -h|--help) print -r -- $u_list; return 0 ;;
          --missing) missing=1 ;;
          *) print -ru2 "upgrade list: unknown option $1"; print -ru2 -r -- $u_list; return 2 ;;
        esac; shift
      done
      while read -r id tool cmd; do
        [[ -z $id || $id == \#* ]] && continue
        if (( $+commands[$tool] )); then (( missing )) || print -r -- "$id	${${cmd//\{greedy\}/}%% #}"
        else (( missing )) && print -r -- "$id	$tool"; fi
      done < $table
      return 0 ;;
    run)
      local greedy= names=() skip=() failed=() skipped=() absent=() known=() g=
      while (( $# )); do
        case $1 in
          -h|--help) print -r -- $u_run; return 0 ;;
          --greedy) greedy=1 ;;
          --skip) (( $# > 1 )) || { print -ru2 "upgrade run: --skip needs a step"; print -ru2 -r -- $u_run; return 2 }; skip+=($2); shift ;;
          -*) print -ru2 "upgrade run: unknown option $1"; print -ru2 -r -- $u_run; return 2 ;;
          *) names+=($1) ;;
        esac; shift
      done
      while read -r id tool cmd; do [[ -z $id || $id == \#* ]] || known+=($id); done < $table
      for id in $names $skip; do
        (( ${known[(Ie)$id]} )) || { print -ru2 "upgrade run: no step named $id (see upgrade list)"; return 2 }
      done
      [[ -n $greedy ]] && g=--greedy
      while read -r id tool cmd; do
        [[ -z $id || $id == \#* ]] && continue
        (( ${#names} )) && (( ! ${names[(Ie)$id]} )) && continue
        (( ${skip[(Ie)$id]} )) && continue
        if (( ! $+commands[$tool] )); then
          (( ${#names} )) && absent+=($id) || skipped+=($id); continue
        fi
        print -P "%F{cyan}==> $id%f"
        cmd=${cmd//\{greedy\}/$g}
        ${=cmd} || failed+=($id)
      done < $table
      (( ${#skipped} )) && print -P "%F{yellow}skipped (not installed): ${skipped[*]}%f"
      (( ${#absent} )) && print -P "%F{red}not installed: ${absent[*]}%f"
      (( ${#failed} )) && print -P "%F{red}failed: ${failed[*]}%f"
      (( ${#failed} + ${#absent} )) && return 1
      print -P "%F{green}done%f" ;;
    *) print -ru2 "upgrade: unknown verb $verb"; print -ru2 -r -- $u_main; return 2 ;;
  esac
}

# clean: free disk with dotclaude's clean command (`clean -h`), from the checkout or else the installed plugin.
# Without it, `clean run` only prunes package caches, each with its own tool, skipping any that is not installed;
# any other call just says so, so `clean -h` never deletes anything.
function clean {
  local s=~/code/dotclaude/plugins/clean/skills/clean/scripts/clean.sh
  [[ -f $s ]] || s=(${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/cache/*/clean/*/skills/clean/scripts/clean.sh(Nom[1]))
  [[ -n $s ]] && { bash "$s" "$@"; return }
  print -P "%F{yellow}The full clean tool is not installed; \`clean run\` prunes package caches only.%f"
  [[ $1 == run ]] || return 0
  local t
  for t in 'brew cleanup --prune=all' 'uv cache clean' 'npm cache verify' 'pnpm store prune' \
           'cd "$(mktemp -d)" && echo {} > package.json && bun pm cache rm' 'pip cache purge'; do
    local tool=${${t##*&& }%% *}
    (( $+commands[$tool] )) || { print "skip $tool: not installed"; continue }
    print -P "%F{cyan}==> $tool%f"
    ( eval "$t" ) || print -P "%F{red}$tool failed%f"
  done
}

# claude
# cc starts plain claude; jcc starts it in jawsome-mode, which fires poteto-mode itself. jawsome-mode only starts
# from its slash command, so jcc sends it as the first message. Leading flags (cc --continue, jcc -r) pass straight
# through. `function` keeps a stale alias from breaking a re-source.
{{ if .work }}# CC_PROFILE picks the aimux profile: its own login, shared skills/agents/plugins.
# ccr and jcc reuse cc's flags instead of repeating them.
{{ end }}function cc {
  {{ if .work }}aimux run "${CC_PROFILE:-jase}"{{ else }}claude{{ end }} --dangerously-skip-permissions{{ if .work }} --chrome{{ end }} "$@"
}
{{ if .work }}function ccr { CC_PROFILE=work cc "$@" }
function ccz { CC_PROFILE=z cc "$@" }   # GLM via z.ai: no Remote Control, no usage in the band
{{ end }}function jcc {
  if [[ $1 == -* ]]; then cc "$@"; else cc "/jawsome-mode $*"; fi
}
{{- if not .work }}

[[ -r ~/.openclaw/completions/openclaw.zsh ]] && source ~/.openclaw/completions/openclaw.zsh
{{- end }}
{{- if and .personalHost .tailnetDomain (ne (lower .chezmoi.hostname) .personalHost) }}

# personal: shell on the personal machine, or run a command there with its aliases/PATH loaded.
# Args form one remote shell string like ssh: personal cc, personal 'cd ~/code/x && cc'
{{- if .personalKeychainRef }}
# Sends the personal machine's login password from 1Password with the connection, for one session only,
# so its keychain unlocks without a prompt.
{{- end }}
personal() {
  local cmd="$*" tty pw=
  [[ -t 0 && -t 1 ]] && tty=-t
{{- if .personalKeychainRef }}
  pw=$(op read --no-newline {{ .personalKeychainRef | quote }} 2>/dev/null)
{{- end }}
  if (( $# )); then
    DOTFILES_KEYCHAIN_PASSWORD=$pw ssh $tty personal zsh -lic ${(q)cmd}
  else
    DOTFILES_KEYCHAIN_PASSWORD=$pw ssh personal
  fi
}
{{- end }}

# >>> cctab hook >>>
# Runs a one-shot command staged by cctab for this exact folder, then forgets it.
_cctab_boot() {
  [[ -o interactive ]] || return 0
  local d="${XDG_CACHE_HOME:-$HOME/.cache}/cctab/pending"
  [[ -d $d ]] || return 0
  local key f tmp
  key=$(printf '%s' "${PWD:A}" | shasum -a 256 | cut -c1-16)
  f="$d/$key.sh"
  [[ -f $f ]] || return 0
  # Older than 3 minutes means the tab was never opened; drop it.
  if [[ -n $(find "$f" -mmin +3 2>/dev/null) ]]; then rm -f -- "$f"; return 0; fi
  # Consume before running so a crash can never re-trigger it.
  tmp="$d/.run-$$-$key.sh"
  mv -f -- "$f" "$tmp" 2>/dev/null || return 0
  source -- "$tmp"
  rm -f -- "$tmp"
}
_cctab_boot
# <<< cctab hook <<<

# LCARS prompt (pills for the folder, git, PR, Node and more)
source ~/.config/zsh/lcars-prompt.zsh

# Fish-style autosuggestions from history and completions, then syntax highlighting (must stay last)
if [[ -r /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  ZSH_AUTOSUGGEST_STRATEGY=(history completion)
  source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi
[[ -r /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] &&
  source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
