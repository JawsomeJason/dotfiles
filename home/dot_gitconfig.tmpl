[user]
	email = {{ .gitEmail }}
	name = {{ .gitName }}
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
{{- if .work }}
[gitbutler]
	aiModelProvider = openai
	diffLengthLimit = 10000
# Personal repos commit with the GitHub no-reply address, never the work email.
[includeIf "hasconfig:remote.*.url:https://github.com/JawsomeJason/**"]
	path = ~/.gitconfig-personal
[includeIf "hasconfig:remote.*.url:git@github.com:JawsomeJason/**"]
	path = ~/.gitconfig-personal
{{- end }}
