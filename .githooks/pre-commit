#!/bin/sh
# Blocks a commit that holds something shaped like a secret, or a word a private layer forbids
# (staged contents, file names, and the author identity). Tokens belong in ~/.config/zsh/local.zsh
# or 1Password (onepasswordRead), never in this repo.
root=$(git rev-parse --show-toplevel)
"$root/scripts/check-secrets.sh" --staged && exec "$root/scripts/check-words.sh" --staged
